---
import { SITE_NAME } from '../config.js';
---
<a href="/" class="flex items-center gap-2 shrink-0" aria-label={`${SITE_NAME} home`}>
  <span class="grid place-items-center w-8 h-8 rounded-lg bg-gradient-to-br from-brand-400 to-brand-600 shadow-sm">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M13 2 4.5 13.5H11L9.5 22 19 10h-6.5L13 2Z" fill="#0b111a" opacity="0.9"/>
    </svg>
  </span>
  <span class="text-lg font-bold tracking-tight text-ink-900 dark:text-ink-50">{SITE_NAME}</span>
</a>
