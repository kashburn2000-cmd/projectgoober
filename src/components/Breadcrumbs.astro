---
import type { Crumb } from '../lib/seo';

interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-xs text-ink-500 mb-4 overflow-x-auto whitespace-nowrap">
  <ol class="flex items-center gap-1.5">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-ink-300 dark:text-ink-600">/</span>}
        {i === crumbs.length - 1
          ? <span aria-current="page" class="text-ink-700 dark:text-ink-300 font-medium">{c.name}</span>
          : <a href={c.href} class="hover:text-brand-700 dark:hover:text-brand-400">{c.name}</a>}
      </li>
    ))}
  </ol>
</nav>
