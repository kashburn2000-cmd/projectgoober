---
interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
}
const { faqs, heading = 'Frequently asked questions' } = Astro.props;
---
<section class="mt-10">
  <h2 class="text-2xl font-bold tracking-tight text-ink-900 dark:text-ink-100 mb-4">{heading}</h2>
  <div class="space-y-3">
    {faqs.map((f) => (
      <details class="group rounded-xl border border-ink-200 dark:border-ink-800 bg-white dark:bg-ink-900 px-5 py-4">
        <summary class="cursor-pointer list-none flex items-center justify-between gap-3 font-medium text-ink-900 dark:text-ink-100">
          {f.q}
          <svg class="shrink-0 transition-transform group-open:rotate-45 text-ink-400" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-400">{f.a}</p>
      </details>
    ))}
  </div>
</section>
