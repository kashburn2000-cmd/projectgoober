---
import Logo from './Logo.astro';

const nav = [
  { href: '/appliances/', label: 'Appliances' },
  { href: '/states/', label: 'States' },
  { href: '/compare/', label: 'Compare' },
  { href: '/guides/', label: 'Guides' },
  { href: '/calculator/', label: 'Calculator' },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-ink-200/70 dark:border-ink-800 bg-ink-50/90 dark:bg-ink-950/90 backdrop-blur">
  <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between gap-4">
    <Logo />
    <nav class="hidden md:flex items-center gap-1" aria-label="Main">
      {nav.map((n) => (
        <a
          href={n.href}
          aria-current={path.startsWith(n.href) ? 'page' : undefined}
          class:list={[
            'px-3 py-1.5 rounded-md text-sm font-medium transition-colors',
            path.startsWith(n.href)
              ? 'text-brand-800 dark:text-brand-300 bg-brand-100 dark:bg-brand-900/40'
              : 'text-ink-600 dark:text-ink-400 hover:text-ink-900 dark:hover:text-ink-100 hover:bg-ink-100 dark:hover:bg-ink-900',
          ]}
        >{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-1">
      <button id="theme-toggle" type="button" aria-label="Toggle dark mode"
        class="p-2 rounded-md text-ink-600 dark:text-ink-400 hover:bg-ink-100 dark:hover:bg-ink-900">
        <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>
      <button id="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false"
        class="md:hidden p-2 rounded-md text-ink-600 dark:text-ink-400 hover:bg-ink-100 dark:hover:bg-ink-900">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="hidden md:hidden border-t border-ink-200 dark:border-ink-800 px-4 py-2" aria-label="Mobile">
    {nav.map((n) => (
      <a href={n.href} class="block px-3 py-2.5 rounded-md text-sm font-medium text-ink-700 dark:text-ink-300 hover:bg-ink-100 dark:hover:bg-ink-900">{n.label}</a>
    ))}
  </nav>
</header>
<script>
  document.getElementById('menu-toggle')?.addEventListener('click', (e) => {
    const nav = document.getElementById('mobile-nav');
    const btn = e.currentTarget as HTMLButtonElement;
    const open = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>
