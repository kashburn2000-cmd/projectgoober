---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="That page doesn't exist. Find appliance running costs, state electricity rates, and calculators.">
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="text-6xl font-extrabold tabular text-brand-600">404</p>
    <h1 class="mt-4 text-2xl font-bold text-ink-900 dark:text-ink-100">That page has been unplugged</h1>
    <p class="mt-3 text-ink-600 dark:text-ink-400">The page you're looking for doesn't exist — but the answers probably do.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">Bill analyzer</a>
      <a href="/appliances/" class="rounded-lg border border-ink-300 dark:border-ink-700 px-5 py-2.5 text-sm font-medium text-ink-700 dark:text-ink-300 hover:bg-ink-100 dark:hover:bg-ink-900">All appliances</a>
      <a href="/calculator/" class="rounded-lg border border-ink-300 dark:border-ink-700 px-5 py-2.5 text-sm font-medium text-ink-700 dark:text-ink-300 hover:bg-ink-100 dark:hover:bg-ink-900">Calculator</a>
    </div>
  </div>
</BaseLayout>
