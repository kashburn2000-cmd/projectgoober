---
import BaseLayout from '../layouts/BaseLayout.astro';
import BillAnalyzer from '../islands/BillAnalyzer.tsx';
import AdSlot from '../components/AdSlot.astro';
import { SITE_NAME, SITE_TAGLINE, SITE_DESCRIPTION } from '../config.js';
import { rates, tier1, appliances, CATEGORIES, stateSlug } from '../lib/data';
import { costs, kwhPerDay, money } from '../lib/calc';
import { AVG_HOME_KWH } from '../lib/content';
import { websiteSchema, webAppSchema } from '../lib/seo';

const stateOptions = rates.states.map((s) => ({ abbr: s.abbr, name: s.name, cents: s.cents }));

const PRESETS: Record<string, number> = {
  refrigerator: 1, 'tv-55-inch': 1, 'washing-machine': 1, 'electric-dryer': 1,
  dishwasher: 1, 'electric-water-heater': 1, 'central-air-conditioner': 1,
  'wifi-router': 1, laptop: 1, 'led-bulb': 12, microwave: 1, 'phone-charger': 2,
};

const analyzerItems = tier1.map((a) => ({
  slug: a.slug,
  name: a.name,
  watts: a.watts,
  kwhDay: kwhPerDay(a.watts, a.use, a.standby ?? 0),
  ...(PRESETS[a.slug] ? { preset: PRESETS[a.slug] } : {}),
}));

const popular = ['space-heater', 'central-air-conditioner', 'electric-dryer', 'electric-water-heater', 'ev-charger', 'refrigerator', 'pool-pump', 'window-air-conditioner', 'gaming-pc', 'hot-tub', 'grow-light', 'dehumidifier']
  .map((slug) => appliances.find((a) => a.slug === slug)!)
  .map((a) => ({ ...a, monthly: costs(a, rates.national.cents).month }));

const cheapest = [...rates.states].sort((a, b) => a.cents - b.cents).slice(0, 3);
const priciest = [...rates.states].sort((a, b) => b.cents - a.cents).slice(0, 3);

const title = `${SITE_NAME} — What Every Appliance Really Costs to Run (${rates.periodLabel} Rates)`;
const description = SITE_DESCRIPTION;
const schema = [
  websiteSchema(),
  webAppSchema({ name: `${SITE_NAME} Bill Analyzer`, description: 'Estimate your monthly electric bill appliance by appliance using current state electricity rates.', path: '/' }),
];
---
<BaseLayout title={title} description={description} schema={schema}>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 text-white">
    <div class="max-w-6xl mx-auto px-4 pt-14 pb-16">
      <div class="max-w-3xl">
        <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-brand-400 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
          Rates updated {rates.periodLabel} · EIA data
        </p>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-tight">
          What's actually driving <span class="text-brand-400">your electric bill?</span>
        </h1>
        <p class="mt-4 text-lg text-ink-300 leading-relaxed max-w-2xl">
          {SITE_TAGLINE}. Most cost guides assume a national-average rate — but real rates run from
          {cheapest[0].cents}¢/kWh in {cheapest[0].name} to {priciest[0].cents}¢ in {priciest[0].name}.
          We compute every number with <em>your state's</em> current rate.
        </p>
      </div>
      <div class="mt-10 text-ink-900">
        <BillAnalyzer client:visible states={stateOptions} nationalCents={rates.national.cents} items={analyzerItems} avgHomeKwh={AVG_HOME_KWH} />
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4">
    <AdSlot variant="banner" />

    <!-- Popular appliances -->
    <section class="mt-12">
      <div class="flex items-end justify-between mb-5">
        <h2 class="text-2xl font-bold tracking-tight text-ink-900 dark:text-ink-100">Most-searched running costs</h2>
        <a href="/appliances/" class="text-sm font-medium text-brand-700 dark:text-brand-400 hover:underline">All {appliances.length} appliances →</a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {popular.map((a) => (
          <a href={`/appliance/${a.slug}/`} class="group rounded-xl border border-ink-200 dark:border-ink-800 bg-white dark:bg-ink-900 p-4 hover:border-brand-400 dark:hover:border-brand-600 hover:shadow-md transition-all">
            <div class="flex items-center justify-between gap-3">
              <span class="font-semibold text-ink-900 dark:text-ink-100 group-hover:text-brand-700 dark:group-hover:text-brand-400">{a.name}</span>
              <span class="text-sm font-bold tabular text-brand-700 dark:text-brand-400 shrink-0">{money(a.monthly)}<span class="text-xs font-normal text-ink-400">/mo</span></span>
            </div>
            <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">at typical usage, U.S. average rate</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Why different -->
    <section class="mt-14 rounded-2xl border border-ink-200 dark:border-ink-800 bg-white dark:bg-ink-900 p-6 sm:p-8">
      <div class="grid gap-8 md:grid-cols-3">
        <div>
          <h2 class="text-lg font-bold text-ink-900 dark:text-ink-100">Your state's real rate</h2>
          <p class="mt-2 text-sm text-ink-600 dark:text-ink-400 leading-relaxed">
            The same space heater costs nearly 4× more to run in Hawaii than North Dakota.
            Every number on this site uses current state-level rates, refreshed monthly from
            U.S. Energy Information Administration data.
          </p>
        </div>
        <div>
          <h2 class="text-lg font-bold text-ink-900 dark:text-ink-100">Real appliance data</h2>
          <p class="mt-2 text-sm text-ink-600 dark:text-ink-400 leading-relaxed">
            {appliances.length} appliances with measured wattage ranges, duty cycles, and realistic
            usage patterns — not the label maximums that overstate half of what's in your house.
          </p>
        </div>
        <div>
          <h2 class="text-lg font-bold text-ink-900 dark:text-ink-100">Answers, then math</h2>
          <p class="mt-2 text-sm text-ink-600 dark:text-ink-400 leading-relaxed">
            Every page leads with the number you came for, then shows the assumptions so you can
            adjust them to your home with the built-in calculators. <a href="/methodology/" class="text-brand-700 dark:text-brand-400 underline">See our methodology</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- Categories -->
    <section class="mt-14">
      <h2 class="text-2xl font-bold tracking-tight text-ink-900 dark:text-ink-100 mb-5">Browse by category</h2>
      <div class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
        {Object.entries(CATEGORIES).map(([key, c]) => {
          const count = appliances.filter((a) => a.cat === key).length;
          return (
            <a href={`/appliances/#${key}`} class="rounded-xl border border-ink-200 dark:border-ink-800 bg-white dark:bg-ink-900 px-4 py-3.5 hover:border-brand-400 dark:hover:border-brand-600 transition-colors flex items-center gap-3">
              <span class="text-xl" aria-hidden="true">{c.icon}</span>
              <span>
                <span class="block text-sm font-semibold text-ink-900 dark:text-ink-100">{c.label}</span>
                <span class="block text-xs text-ink-500">{count} appliances</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- States -->
    <section class="mt-14">
      <div class="flex items-end justify-between mb-5">
        <h2 class="text-2xl font-bold tracking-tight text-ink-900 dark:text-ink-100">Electricity costs in your state</h2>
        <a href="/states/" class="text-sm font-medium text-brand-700 dark:text-brand-400 hover:underline">Full rankings →</a>
      </div>
      <div class="flex flex-wrap gap-2">
        {rates.states.map((s) => (
          <a href={`/state/${stateSlug(s)}/`} class="rounded-lg border border-ink-200 dark:border-ink-800 bg-white dark:bg-ink-900 px-3 py-1.5 text-sm text-ink-700 dark:text-ink-300 hover:border-brand-400 dark:hover:border-brand-600 hover:text-brand-700 dark:hover:text-brand-400 transition-colors">
            {s.name} <span class="tabular text-ink-400">{s.cents}¢</span>
          </a>
        ))}
      </div>
    </section>

    <AdSlot variant="banner" />
  </div>
</BaseLayout>
