---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import { breadcrumbSchema, articleSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Guides', href: '/guides/' },
  { name: guide.data.title, href: `/guides/${guide.id}/` },
];
const others = (await getCollection('guides')).filter((g) => g.id !== guide.id).sort(() => 0).slice(0, 4);
const schema = [
  breadcrumbSchema(crumbs),
  articleSchema({
    title: guide.data.title,
    description: guide.data.description,
    path: `/guides/${guide.id}/`,
    datePublished: guide.data.date,
    dateModified: guide.data.updated ?? guide.data.date,
  }),
];
---
<BaseLayout title={guide.data.title} description={guide.data.description} schema={schema}>
  <div class="max-w-6xl mx-auto px-4 pt-6">
    <Breadcrumbs crumbs={crumbs} />
    <div class="lg:grid lg:grid-cols-[1fr_300px] lg:gap-10">
      <article>
        <header>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink-900 dark:text-ink-100 leading-tight">{guide.data.title}</h1>
          <p class="mt-3 text-sm text-ink-500">Updated {(guide.data.updated ?? guide.data.date).slice(0, 7).replace('-', '/')} · {guide.data.category}</p>
        </header>
        <AdSlot variant="banner" />
        <div class="mt-6 prose-custom max-w-none">
          <Content />
        </div>
        <AdSlot variant="banner" />
        <section class="mt-10 mb-4">
          <h2 class="text-xl font-bold tracking-tight text-ink-900 dark:text-ink-100 mb-4">Keep reading</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {others.map((g) => (
              <a href={`/guides/${g.id}/`} class="rounded-xl border border-ink-200 dark:border-ink-800 bg-white dark:bg-ink-900 p-4 hover:border-brand-400 dark:hover:border-brand-600 transition-colors">
                <span class="text-sm font-semibold text-ink-900 dark:text-ink-100 leading-snug">{g.data.title}</span>
              </a>
            ))}
          </div>
        </section>
      </article>
      <aside class="hidden lg:block">
        <div class="sticky top-20">
          <div class="rounded-2xl border border-ink-200 dark:border-ink-800 bg-white dark:bg-ink-900 p-5 text-sm">
            <h2 class="font-bold text-ink-900 dark:text-ink-100 mb-2">Tools</h2>
            <ul class="space-y-2 text-ink-600 dark:text-ink-400">
              <li><a href="/" class="hover:text-brand-700 dark:hover:text-brand-400">Whole-home bill analyzer</a></li>
              <li><a href="/calculator/" class="hover:text-brand-700 dark:hover:text-brand-400">Cost calculator</a></li>
              <li><a href="/appliances/" class="hover:text-brand-700 dark:hover:text-brand-400">Appliance database</a></li>
              <li><a href="/states/" class="hover:text-brand-700 dark:hover:text-brand-400">Rates by state</a></li>
            </ul>
          </div>
          <AdSlot variant="sidebar" />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
